    },
    {
      "tokens": "columns?|pillars?|piers?|posts?|beams?|slats?|trim|caps?|ycap|junctions?|joints?|anchors?|suspension|carriers?|structure|frames?|gasket|mullions?|plinth|foundation|raft|reveal|rails?|clips?|washers?|bezels?",
      "label": "structure"
    }
  ],
  "material_rules": [
