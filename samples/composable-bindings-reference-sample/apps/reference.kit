[package]
title = "Composable Bindings - Default Reference"
version = "0.1.0"
[dependencies]
"omni.kit.mainwindow" = {}
"omni.kit.viewport.window" = {}
"omni.kit.manipulator.camera" = {}
"omni.hydra.rtx" = {}
"omni.example.reference_client" = {}
[settings]
app.window.title = "Composable Bindings - Default Reference"
app.window.width = 1280
app.window.height = 800
app.settings.persistent = false
app.content.emptyStageOnStart = true
renderer.enabled = "rtx"
renderer.active = "rtx"
