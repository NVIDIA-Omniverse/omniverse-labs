{
  "version": 1,
  "source": "factory_simulator",
  "assets": [
    {
      "id": "mock-controller-1"
    },
    {
      "id": "mock-controller-2"
    },
    {
      "id": "mock-line-1"
    }
  ],
  "events": [
    {
      "type": "org.example.measurements.v1",
      "assets": [
        "mock-controller-1",
        "mock-controller-2"
      ],
      "interval": 0.5,
      "metrics": [
        {
          "name": "equipment.temperature",
          "simulation": {
            "center": 65,
            "amplitude": 15,
            "period": 7
          }
        },
        {
          "name": "equipment.pressure",
          "simulation": {
            "center": 180,
            "amplitude": 20,
            "period": 11
          }
        },
        {
          "name": "equipment.throughput",
          "simulation": {
            "center": 45,
            "amplitude": 5,
            "period": 60
          }
        }
      ]
    },
    {
      "type": "org.example.line.v1",
      "assets": [
        "mock-line-1"
      ],
      "interval": 0.5,
      "metrics": [
        {
          "name": "line.throughput",
          "aggregate": {
            "operation": "sum",
            "metric": "equipment.throughput",
            "members": [
              "mock-controller-1",
              "mock-controller-2"
            ]
          }
        }
      ]
    }
  ]
}
