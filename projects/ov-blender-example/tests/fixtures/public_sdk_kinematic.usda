#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 1
)
def Xform "World" {
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    ) {
        bool physxScene:enableGPUDynamics = true
        uniform token physxScene:broadphaseType = "GPU"
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 0
    }
    def Sphere "Kinematic" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    ) {
        double radius = 0.2
        float physics:mass = 1
        bool physics:kinematicEnabled = true
        bool physics:rigidBodyEnabled = true
        double3 xformOp:translate = (-1, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "Dynamic" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    ) {
        double radius = 0.2
        float physics:mass = 1
        bool physics:rigidBodyEnabled = true
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
