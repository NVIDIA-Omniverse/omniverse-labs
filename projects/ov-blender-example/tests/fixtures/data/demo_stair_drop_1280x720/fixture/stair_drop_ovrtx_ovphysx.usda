}

def "Render"
{
    def "OmniverseKit"
    {
        def "HydraTextures"
        {
            def RenderProduct "ViewportTexture0"
            {
                rel camera = </World/Camera>
                token omni:rtx:rendermode = "RealTimePathTracing"
                token omni:rtx:background:source:type = "sky"
                rel orderedVars = </Render/OmniverseKit/HydraTextures/ViewportTexture0/LdrColor>
                uniform int2 resolution = (1280, 720)
                bool omni:rtx:indirectDiffuse:denoiser:enabled = true
                bool omni:rtx:reflections:denoiser:enabled = true
                bool omni:rtx:dlss:frameGeneration = false
                bool omni:rtx:autoExposure:enabled = false
                bool omni:rtx:rt:ecoMode:enabled = false
                int omni:rtx:rtpt:maxVolumeBounces = 4
                color3f omni:rtx:rt:ambientLight:color = (0.02, 0.02, 0.025)
                def RenderVar "LdrColor"
                {
                    uniform string sourceName = "LdrColor"
                }
            }
        }
    }
}
