    {
        float focalLength = 22
        float horizontalAperture = 31.4
        float verticalAperture = 17.6625
        float2 clippingRange = (0.05, 100)
        float fStop = 0
        matrix4d xformOp:transform = ((-0.865771, 0.50044, 0, 0), (-0.135391, -0.23423, 0.962708, 0), (0.481777, 0.833485, 0.270544, 0), (4.63, 7.56, 4.45, 1))
