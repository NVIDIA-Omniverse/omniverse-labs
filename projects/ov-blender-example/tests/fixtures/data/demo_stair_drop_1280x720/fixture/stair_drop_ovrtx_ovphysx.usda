    def DomeLight "StudioDome"
    {
        float inputs:intensity = 440
        color3f inputs:color = (0.72, 0.78, 0.88)
        token inputs:texture:format = "latlong"
    }

    def RectLight "KeyLight"
    {
        float inputs:intensity = 3200
        color3f inputs:color = (1, 0.96, 0.88)
        float inputs:width = 3.5
        float inputs:height = 2.2
        bool inputs:normalize = false
        double3 xformOp:translate = (-2.8, -3.8, 6.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RectLight "RimLight"
    {
        float inputs:intensity = 850
        color3f inputs:color = (0.55, 0.72, 1)
